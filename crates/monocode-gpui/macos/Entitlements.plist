<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The native app under the hardened runtime (release signing). -->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<!-- Websites in the browser may ask for these; macOS still asks the user. -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Signing in with a passkey on a phone (hybrid): Chromium's browser
	     process listens for the phone over Bluetooth (K58). Chrome's app
	     entitlements have it too; the helpers need none of these. -->
	<key>com.apple.security.device.bluetooth</key>
	<true/>
	<key>com.apple.security.personal-information.location</key>
	<true/>
</dict>
</plist>
